@page "/EntradasHuacales/Index"
@inject EntradasHuacalesServices entradasHuacalesServices
@rendermode InteractiveServer
@inject NavigationManager navigationManager

<PageTitle> Index de Entradas Huacales</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-around align-content-between align-items-center">
            <h5 class="card-title mb-0"> Index de Entradas Huacales </h5>
            <a href="/EntradasHuacales/Create" class="btn btn-primary ms-auto">
                <i class="bi bi-plus-square"></i> Crear
            </a>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-3">
                    <label><strong>Fecha Desde</strong></label>
                    <InputDate class="form-control" @bind-Value="FechaDesde" />
                </div>
                <div class="col-3">
                    <label><strong>Fecha Hasta</strong></label>
                    <InputDate class="form-control" @bind-Value="FechaHasta" />
                </div>
                <div class="col-3 d-flex align-items-end">
                    <button class="btn btn-outline-primary w-100" @onclick="FiltrarPorRango">
                        <i class="bi bi-calendar-range"></i> Filtrar Rango
                    </button>
                </div>
            </div>

            <div class="row align-items-end mb-3">
                <div class="col-3">
                    <label class="form-label"><strong>Filtrar por</strong></label>
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opcion</option>
                        <option value="EntradaId">EntradaId</option>
                        <option value="NombreCliente">NombreCliente</option>
                        <option value="Precio">Precio</option>
                        <option value="Fecha">Fecha</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <label class="form-label"><strong>Busqueda</strong></label>
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                        <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise" @onclick="Restablecer"></button>
                    </div>
                </div>
            </div>

            <table class="table table-hover">
                <thead class="table table-striped text-black">
                    <tr>
                        <th>EntradaId</th>
                        <th>NombreCliente</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Importe</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entradaHuacales in ListaEntradasHuacales)
                    {
                        <tr>
                            <td>@entradaHuacales.EntradaId</td>
                            <td>@entradaHuacales.NombreCliente</td>
                            <td>@entradaHuacales.Cantidad</td>
                            <td>@entradaHuacales.Precio</td>
                            <td>@(entradaHuacales.Precio*entradaHuacales.Cantidad)</td>
                            <td>@entradaHuacales.Fecha.ToShortDateString()</td>

                            <td class="text-center">
                                <a href="/EntradasHuacales/Edit/@entradaHuacales.EntradaId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer space-between text-end">
            <label>TotalDeCantidades: @ListaEntradasHuacales.Sum(a => a.Cantidad)</label>
            <label>TotalDeImportes : @ListaEntradasHuacales.Sum(a => a.Precio*a.Cantidad)</label>
        </div>
    </div>
</div>


@code {
    public List<EntradasHuacales> ListaEntradasHuacales { get; set; } = new List<EntradasHuacales>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    private DateTime? FechaDesde { get; set; }
    private DateTime? FechaHasta { get; set; }
    protected override async Task OnInitializedAsync()
    {
        ListaEntradasHuacales = await entradasHuacalesServices.Listar(j => j.EntradaId > 0);
    }

    private async Task Buscar()
    {
        if (!string.IsNullOrWhiteSpace(ValorFiltro))
        {
            if (Filtro == nameof(EntradasHuacales.EntradaId) && int.TryParse(ValorFiltro, out var entradaId))
            {
                ListaEntradasHuacales = await entradasHuacalesServices.Listar(j => j.EntradaId == entradaId);
            }
            else if (Filtro == nameof(EntradasHuacales.NombreCliente))
            {
                ListaEntradasHuacales = await entradasHuacalesServices.Listar(
                j => j.NombreCliente.ToLower().Contains(ValorFiltro.ToLower())
                );
            }
            else if (Filtro == nameof(EntradasHuacales.Cantidad) && int.TryParse(ValorFiltro, out var Cantidad))
            {
                ListaEntradasHuacales = await entradasHuacalesServices.Listar(j => j.Cantidad == Cantidad);
            }
            else if (Filtro == nameof(EntradasHuacales.Fecha) && DateTime.TryParse(ValorFiltro, out var fecha))
            {
                ListaEntradasHuacales = await entradasHuacalesServices.Listar(
                j => j.Fecha.Date == fecha.Date
                );
            }
        }
        else
        {
            ListaEntradasHuacales = await entradasHuacalesServices.Listar(j => j.EntradaId > 0);
        }
    }

    private async Task Restablecer()
    {
        ListaEntradasHuacales = await entradasHuacalesServices.Listar(j => j.EntradaId > 0);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }
    private async Task FiltrarPorRango()
    {
        ListaEntradasHuacales = await entradasHuacalesServices.Listar(e =>
            (!FechaDesde.HasValue || e.Fecha.Date >= FechaDesde.Value.Date) &&
            (!FechaHasta.HasValue || e.Fecha.Date <= FechaHasta.Value.Date)
        );
    }
}

