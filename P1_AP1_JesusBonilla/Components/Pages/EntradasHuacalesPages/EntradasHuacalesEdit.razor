@page "/EntradasHuacales/Edit/{EntradaId:int}"

@inject EntradasHuacalesServices entradasHuacalesService
@inject NavigationManager navigationManager
@inject ToastService toastService
@rendermode InteractiveServer

<PageTitle>Modificar Entradas Huacales</PageTitle>

<Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.TopRight" />

<EditForm Model="Entrada" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container mt-4">
        <div class="card shadow-lg">

            @* ENCABEZADO *@
            <div class="card-header text-center">
                <h5 class="card-title mb-0">Modificar Entrada</h5>
            </div>

            @* CUERPO *@
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label"><strong>EntradaId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Entrada.EntradaId" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Entrada.Fecha" />
                    <ValidationMessage For="@(() => Entrada.Fecha)" />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Nombre del Cliente</strong></label>
                    <InputText class="form-control" @bind-Value="Entrada.NombreCliente" />
                    <ValidationMessage For="@(() => Entrada.NombreCliente)" />
                </div>

                <div class="border border-success p-3 mt-3 rounded">
                    <h5 class="text-center mb-3">Detalles de la Entrada</h5>

                    <div class="col-auto input-group align-items-center">
                        <label class="col-form-label input-group-text">Tipo:</label>
                        <InputSelect class="form-select" @bind-Value="Detalle.TipoId">
                            <option disabled value="0">Seleccione un tipo de huacal</option>
                            @foreach (var tipo in ListaTipos)
                            {
                                <option value="@tipo.TipoId">@tipo.Descripcion - (@tipo.Existencias disponibles)</option>
                            }
                        </InputSelect>

                        <label class="col-form-label input-group-text">Cantidad:</label>
                        <InputNumber class="form-control" @bind-Value="Detalle.Cantidad" />

                        <label class="col-form-label input-group-text">Precio:</label>
                        <InputNumber class="form-control" @bind-Value="Detalle.Precio" />

                        <button type="button" class="btn btn-outline-success" @onclick="AgregarDetalle">
                            <span class="bi bi-plus"></span> Agregar
                        </button>
                    </div>

                    <table class="table table-striped table-bordered mt-3">
                        <thead class="table-success text-center">
                            <tr>
                                <th>Tipo</th>
                                <th>Cantidad</th>
                                <th>Precio</th>
                                <th>Importe</th>
                                <th>Remover</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Entrada.EntradasHuacalesDetalles)
                            {
                                <tr class="text-center">
                                    <td>@ListaTipos.FirstOrDefault(t => t.TipoId == detalle.TipoId)?.Descripcion</td>
                                    <td>@detalle.Cantidad</td>
                                    <td>RD$@Math.Round(detalle.Precio, 2)</td>
                                    <td>RD$@Math.Round(detalle.Cantidad * detalle.Precio, 2)</td>
                                    <td>
                                        <button type="button" class="btn btn-outline-danger" @onclick="() => RemoverDetalle(detalle)">
                                            <span class="bi bi-trash"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row mt-3">
                    <div class="col-6 text-end">
                        <label class="form-label"><strong>Total Cantidad:</strong></label>
                        <div class="form-control text-end"><strong>@Entrada.Cantidad</strong></div>
                    </div>
                    <div class="col-6 text-end">
                        <label class="form-label"><strong>Total Importe:</strong></label>
                        <div class="form-control text-end"><strong>RD$@Math.Round(Entrada.Importe, 2)</strong></div>
                    </div>
                </div>
            </div>

            @* PIE *@
            <div class="card-footer text-center">
                <div class="btn-group">
                    <a href="/EntradasHuacales/Index" class="btn btn-outline-secondary">
                        <span class="bi bi-arrow-bar-left"></span> Volver
                    </a>

                    @if (!modificado)
                    {
                        <button type="submit" class="btn btn-outline-success">
                            <span class="bi bi-check-circle"></span> Guardar
                        </button>

                        <button type="button" class="btn btn-outline-danger" @onclick="MostrarModalEliminar">
                            <span class="bi bi-trash-fill"></span> Eliminar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</EditForm>

@if (MostrarModal)
{
    <div class="modal show fade" style="display:block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar esta entrada?</p>
                    <p><strong>ID:</strong> @Entrada.EntradaId</p>
                    <p><strong>Cliente:</strong> @Entrada.NombreCliente</p>
                    <p><strong>Cantidad:</strong> @Entrada.Cantidad</p>
                    <p><strong>Importe:</strong> RD$@Math.Round(Entrada.Importe, 2)</p>
                    <p><strong>Fecha:</strong> @Entrada.Fecha.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CerrarModalEliminar">
                        <span class="bi bi-arrow-bar-left"></span> Cancelar
                    </button>
                    <button class="btn btn-outline-danger" @onclick="Eliminar">
                        <span class="bi bi-trash-fill"></span> Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int EntradaId { get; set; }

    public EntradasHuacales Entrada { get; set; } = new();
    public EntradasHuacalesDetalles Detalle { get; set; } = new();
    public List<TiposHuacales> ListaTipos { get; set; } = [];
    public bool MostrarModal { get; set; } = false;
    public bool modificado { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        Entrada = await entradasHuacalesService.Buscar(EntradaId);
        ListaTipos = await entradasHuacalesService.ListarTipos();
    }

    private void AgregarDetalle()
    {
        if (Detalle.TipoId < 1)
        {
            toastService.ShowWarning("Debe seleccionar un tipo de huacal");
            return;
        }

        if (Detalle.Cantidad < 1)
        {
            toastService.ShowWarning("La cantidad debe ser mayor que cero");
            return;
        }

        if (Detalle.Precio < 0.01)
        {
            toastService.ShowWarning("El precio debe ser mayor que cero");
            return;
        }

        Entrada.EntradasHuacalesDetalles.Add(Detalle);
        CalcularTotales();
        Detalle = new EntradasHuacalesDetalles();
    }

    private void RemoverDetalle(EntradasHuacalesDetalles detalle)
    {
        Entrada.EntradasHuacalesDetalles.Remove(detalle);
        CalcularTotales();
        Detalle = detalle;
    }

    private void CalcularTotales()
    {
        Entrada.Cantidad = Entrada.EntradasHuacalesDetalles.Sum(d => d.Cantidad);
        Entrada.Importe = Entrada.EntradasHuacalesDetalles.Sum(d => d.Cantidad * d.Precio);
    }

    private async Task Modificar()
    {
        modificado = await entradasHuacalesService.Guardar(Entrada);
        if (modificado)
        {
            toastService.ShowSuccess("Entrada modificada correctamente");
            await Task.Delay(2000);
            navigationManager.NavigateTo("/EntradasHuacales/Index");
        }
        else
        {
            toastService.ShowError("Error al modificar la entrada");
        }
    }

    private async Task Eliminar()
    {
        modificado = await entradasHuacalesService.Eliminar(EntradaId);
        if (modificado)
        {
            toastService.ShowSuccess("Entrada eliminada correctamente");
            await Task.Delay(2000);
            navigationManager.NavigateTo("/EntradasHuacales/Index");
        }
        else
        {
            toastService.ShowError("Error al eliminar la entrada");
        }

        CerrarModalEliminar();
    }

    private void MostrarModalEliminar()
    {
        MostrarModal = true;
    }

    private void CerrarModalEliminar()
    {
        MostrarModal = false;
    }
}



